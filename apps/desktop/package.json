    "pinia": "^4.1.0",
    "qrcode": "1.5.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.14"
  }
