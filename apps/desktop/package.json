{
  "name": "@pel/desktop",
  "productName": "WolfCore Dev",
  "version": "0.1.0",
  "private": true,
  "description": "WolfCore Dev: aplicación de escritorio",
  "author": "Johan Velez",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
