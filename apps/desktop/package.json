{
  "name": "@pel/desktop",
  "productName": "WolfCore Dev",
  "version": "0.1.0",
  "private": true,
  "description": "WolfCore Dev: aplicación de escritorio",
  "author": "Johan Velez",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "vite build -c vite.cli.config.ts && electron-vite dev",
    "build:cli": "vite build -c vite.cli.config.ts",
    "build": "electron-vite build && vite build -c vite.cli.config.ts",
    "preview": "electron-vite preview",
    "dist:dir": "electron-vite build && vite build -c vite.cli.config.ts && electron-builder --dir --config electron-builder.yml",
    "humo": "node scripts/humo.mjs",
    "dist": "electron-vite build && vite build -c vite.cli.config.ts && electron-builder --config electron-builder.yml",
    "dist:win": "electron-vite build && vite build -c vite.cli.config.ts && electron-builder --win --config electron-builder.yml",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.2",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.1",
    "@lezer/highlight": "1.2.5",
    "@pel/core": "*",
    "@vicons/ionicons5": "^0.13.0",
    "@zxcvbn-ts/core": "4.3.0",
    "@zxcvbn-ts/language-common": "4.2.0",
    "bcryptjs": "3.0.3",
    "diff": "9.0.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "markdown-it": "15.0.3",
    "naive-ui": "^2.45.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pinia": "^4.1.0",
    "qrcode": "1.5.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.14"
  }
}
